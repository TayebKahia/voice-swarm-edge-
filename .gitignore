# =====================================================================
#  PFE -- Voice-controlled drone swarm on Raspberry Pi 5
#
#  Rule: SOURCES are committed, DERIVATIVES are regenerated.
#  A file belongs in git if losing it would cost you a recording
#  session or an experiment run. Everything a script can rebuild
#  from committed inputs stays out.
#
#  Directories whose contents are ignored keep a .gitkeep so the
#  skeleton is still tracked. That is why each block is written as
#  "dir/*" plus "!dir/.gitkeep" -- git cannot re-include a file
#  whose parent directory is itself excluded.
# =====================================================================

# ---------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------
# LaTeX build output -- rebuilt by: python tools/build_pdf.py
# ---------------------------------------------------------------------
build/
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.nav
*.snm

# ---------------------------------------------------------------------
# Model artefacts -- approx. 6 GB. Rebuilt from train/ checkpoints
# with llama-quantize. LICENSE_MODELS.md IS committed.
# ---------------------------------------------------------------------
gguf/*
!gguf/.gitkeep
!gguf/LICENSE_MODELS.md

# LoRA adapters and HF checkpoints. Training LOGS are committed
# (tab:repo requires them); weights are not.
train/checkpoints/
train/adapters/
train/runs/
train/wandb/
*.safetensors
*.bin
*.pt

# ---------------------------------------------------------------------
# Derived audio -- regenerate with: python data/mix_noise.py
# Roughly 1.2 GB of SNR mixes plus 250 MB of TTS.
# ---------------------------------------------------------------------
data/audio/tts/*
!data/audio/tts/.gitkeep
data/audio/roundtrip/*
!data/audio/roundtrip/.gitkeep
data/audio/mixed/snr20/*
!data/audio/mixed/snr20/.gitkeep
data/audio/mixed/snr15/*
!data/audio/mixed/snr15/.gitkeep
data/audio/mixed/snr10/*
!data/audio/mixed/snr10/.gitkeep
data/audio/mixed/snr05/*
!data/audio/mixed/snr05/.gitkeep

# ---------------------------------------------------------------------
# Wake-word corpus -- approx. 490 MB, regenerated by openWakeWord's
# Piper pipeline from the two word-list entries.
# ---------------------------------------------------------------------
data/wake/pos_swarm_hold/*
!data/wake/pos_swarm_hold/.gitkeep
data/wake/pos_swarm_abort/*
!data/wake/pos_swarm_abort/.gitkeep
data/wake/neg/*
!data/wake/neg/.gitkeep

# ---------------------------------------------------------------------
# Downloaded corpora -- every URL and licence is recorded in
# data/dataset_card.md, which is committed. The bytes are not.
# ---------------------------------------------------------------------
data/noise/*
!data/noise/.gitkeep
data/commonvoice/*
!data/commonvoice/.gitkeep

# ---------------------------------------------------------------------
# NOT ignored, listed here so the intent is explicit:
#   data/audio/s1/  s2/  s3/   320 irreplaceable recordings (~154 MB)
#   data/annot/                sealed annotation passes
#   data/*.jsonl               raw pairs and the five splits
#   results/*.csv              every raw trial (NFR-19)
#   train/*.log, train/*.yaml  training logs and per-model configs
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# Local tooling and OS noise
# ---------------------------------------------------------------------
.claude/settings.local.json
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
*.swp
tips.md
pfe_prd.pdf
prd.md
docs/prd.md
docs/project/  
IMPLEMENTATION_ROADMAP.md
START_SESSION.md
