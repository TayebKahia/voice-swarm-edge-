# =====================================================================
#  PFE -- Voice-controlled drone swarm on Raspberry Pi 5
#
#  Rule: SOURCES are committed, DERIVATIVES are regenerated.
#  A file belongs in git if losing it would cost you a recording
#  session or an experiment run. Everything a script can rebuild
#  from committed inputs stays out.
#
#  Directories whose contents are ignored keep a .gitkeep so the
#  skeleton is still tracked. That is why each block is written as
#  "dir/*" plus "!dir/.gitkeep" -- git cannot re-include a file
#  whose parent directory is itself excluded.
# =====================================================================

# ---------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------
# LaTeX source and build output
# ---------------------------------------------------------------------
thesis/
build/
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.nav
*.snm
# biblatex/biber
*.bcf
*.run.xml
# glossaries (thesis/ acronym list)
*.acn
*.acr
*.alg
*.glg
*.glo
*.gls
*.glsdefs
*.ist
# The theses build out-of-tree, one folder each, into thesis/build/master/ and
# thesis/build/ingenieur/ (see thesis/.latexmkrc), which the build/ rule above
# already covers -- intermediates AND the two PDFs. They are reproducible with
# `cd thesis && latexmk main_master.tex` (or main_ingenieur.tex).

# ---------------------------------------------------------------------
# Model artefacts -- approx. 6 GB. Rebuilt from train/ checkpoints
# with llama-quantize. LICENSE_MODELS.md IS committed.
# ---------------------------------------------------------------------
gguf/*
!gguf/.gitkeep
!gguf/LICENSE_MODELS.md
# The manifest is provenance, not an artefact: it names the llama.cpp build and the
# SHA-256 of each quantised file. Table 18 is a claim about specific bytes, and
# "the Q4_K_M scored X" is unreproducible without saying which Q4_K_M.
!gguf/artefacts.json

# LoRA adapters and HF checkpoints. Training LOGS are committed
# (tab:repo requires them); weights are not.
train/checkpoints/
train/adapters/
train/runs/
train/wandb/
*.safetensors
*.bin
*.pt

# ---------------------------------------------------------------------
# Derived audio -- regenerate with: python data/mix_noise.py
# Roughly 1.2 GB of SNR mixes plus 250 MB of TTS.
# ---------------------------------------------------------------------
data/audio/tts/*
!data/audio/tts/.gitkeep
data/audio/roundtrip/*
!data/audio/roundtrip/.gitkeep
data/audio/mixed/snr20/*
!data/audio/mixed/snr20/.gitkeep
data/audio/mixed/snr15/*
!data/audio/mixed/snr15/.gitkeep
data/audio/mixed/snr10/*
!data/audio/mixed/snr10/.gitkeep
data/audio/mixed/snr05/*
!data/audio/mixed/snr05/.gitkeep

# ---------------------------------------------------------------------
# Wake-word corpus -- approx. 490 MB, regenerated by openWakeWord's
# Piper pipeline from the two word-list entries.
# ---------------------------------------------------------------------
data/wake/pos_swarm_hold/*
!data/wake/pos_swarm_hold/.gitkeep
data/wake/pos_swarm_abort/*
!data/wake/pos_swarm_abort/.gitkeep
data/wake/neg/*
!data/wake/neg/.gitkeep

# ---------------------------------------------------------------------
# Downloaded corpora -- every URL and licence is recorded in
# data/dataset_card.md, which is committed. The bytes are not.
# ---------------------------------------------------------------------
data/noise/*
!data/noise/.gitkeep
data/commonvoice/*
# ...except the Exp-0 sample's manifest: it carries the reference transcripts
# every WER number is measured against, and the accent bucket that is Exp-0's
# independent variable. The audio is regenerable from it; it is not regenerable
# from the audio.
!data/commonvoice/exp0_manifest.jsonl
!data/commonvoice/exp0_summary.json
!data/commonvoice/.gitkeep

# Piper voice models fetched by data/fetch_assets.py (~190 MB of ONNX).
# Provenance -- URL, SHA-256, licence -- lives in the committed
# data/asset_manifest.json, so the bytes are reproducible without being tracked.
data/tts_voices/

# Session 03 source archives: LibriSpeech dev-clean, Speech Commands v2 test set,
# the MIT impulse-response survey, and the Common Voice 17.0 en test shard. ~1.2 GB
# of third-party corpora. URL, SHA-256 and licence for each are in the committed
# data/asset_manifest.json; re-fetch with `python data/fetch_assets.py`.
data/wake/_src/
data/commonvoice/_src/

# ---------------------------------------------------------------------
# NOT ignored, listed here so the intent is explicit:
#   data/audio/s1/  s2/  s3/   320 irreplaceable recordings (~154 MB)
#   data/annot/                sealed annotation passes
#   data/*.jsonl               raw pairs and the five splits
#   results/*.csv              every raw trial (NFR-19)
#   train/*.log, train/*.yaml  training logs and per-model configs
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# Local tooling and OS noise
# ---------------------------------------------------------------------
.agents/
.claude/
.scratch/
.gemini/
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
*.swp
tips.md
pfe_prd.pdf
prd.md
docs/prd.md
docs/project/  
IMPLEMENTATION_ROADMAP.md
START_SESSION.md

# Generated by train/make_kaggle_bundle.py -- rebuild rather than track.
train/pfe_kaggle_data.zip
# whisper.cpp -otxt sidecars; data/asr.py removes them, this catches interrupted runs.
*.wav.txt

# Kaggle outputs. The weights are large and reproducible from the notebook; the small
# result files beside them are evidence for Tables 17 and 18 and are tracked.
train/kaggle_out/gguf/
train/kaggle_out/adapters/**/adapter_model.safetensors

# Surface-B per-item predictions: regenerated by eval/surface_b.py, but the paired
# predictions ARE the input to Session 07's McNemar test, so they are tracked.
!results/surface_b_preds/
thesis/sample_thesis
# Branch A: cached wake-corpus embeddings and the trained heads (regenerate: python train/train_wake.py;
# head hashes are tracked in runtime/models/wake/wake_heads.json)
train/wake_features/
runtime/models/wake/*.onnx

# ---------------------------------------------------------------------
# Demonstration runs (runtime/main.py, demo/workstation.py): logs,
# trajectories and screenshots of one live run. Kept out of results/,
# which holds only measured experiments; the video is archived by hand.
# ---------------------------------------------------------------------
demo_runs/
